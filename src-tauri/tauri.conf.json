{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TwoGG Pinecone",
  "mainBinaryName": "twogg-pinecone",
  "version": "0.1.0",
  "identifier": "de.twogg.pinecone",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TwoGG Pinecone",
        "width": 1120,
        "height": 720,
        "minWidth": 880,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost https://cdn.modrinth.com https://media.forgecdn.net; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Minecraft-Launcher der TwoGG-Community",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
