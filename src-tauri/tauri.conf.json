{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TwoGG Pinecone",
  "mainBinaryName": "twogg-pinecone",
  "version": "0.1.0",
  "identifier": "de.twogg.pinecone",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TwoGG Pinecone",
        "width": 1120,
        "height": 720,
        "minWidth": 880,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost https://cdn.modrinth.com https://media.forgecdn.net; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "deb", "rpm"],
    "category": "Game",
    "publisher": "TwoGG",
    "copyright": "© TwoGG-Community",
    "license": "MIT OR Apache-2.0",
    "homepage": "https://github.com/wheatley2056/twogg-pinecone",
    "shortDescription": "Minecraft-Launcher der TwoGG-Community",
    "longDescription": "TwoGG Pinecone ist der Minecraft-Launcher der TwoGG-Community: Profile, Fabric und Quilt, Modrinth und CurseForge, Modpacks, Sync-Packs, Skins und Screenshots.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German", "English"],
        "displayLanguageSelector": false
      },
      "wix": { "language": ["de-DE", "en-US"] }
    },
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"] },
      "rpm": { "depends": ["webkit2gtk4.1", "gtk3"] }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["mrpack"],
        "name": "Modrinth-Modpack",
        "description": "Modpack für TwoGG Pinecone",
        "mimeType": "application/x-modrinth-modpack+zip",
        "role": "Viewer"
      }
    ]
  },
  "plugins": {
    "updater": { "pubkey": "", "endpoints": [], "windows": { "installMode": "passive" } },
    "deep-link": {
      "desktop": { "schemes": ["pinecone"] }
    }
  }
}
