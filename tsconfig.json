{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["ui/src/**/*.ts", "ui/src/**/*.svelte", "ui/skin-editor/**/*.ts", "ui/vendor/mc-skin-editor/src/vite-env.d.ts"]
}
